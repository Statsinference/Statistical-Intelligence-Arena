  "english_display": {},
  "paper": {
    "citation": "Qiu, Y., Tao, J., and Zhou, X.-H. (2021). Inference of Heterogeneous Treatment Effects using Observational Data with High-Dimensional Covariates. Journal of the Royal Statistical Society Series B 83(5), 1016-1043. DOI 10.1111/rssb.12469.",
    "title": null,
    "doi": null,
    "source_url": "https://academic.oup.com/jrsssb/article/83/5/1016/7056069",
    "source_file_evidence": [],
    "venue": "Journal of the Royal Statistical Society Series B",
    "year": 2021,
    "source_version": null,
    "source_locator": "Publisher full-text HTML Section 2 Eq. (1) LCSTE and Assumption 1; Section 6 DGP2 Eq. (38), preceding X,Z,D generation and following fixed constants and p grid. Equation (38) MathML inspected to confirm identical Poisson subgroup additions to both potential outcomes. No author code used; fixed commit not applicable."
  },
  "mechanism": {
    "name": "IV: monotone threshold compliance with Poisson principal-stratum confounding",
    "title_en": null,
    "family_id": "qiu-2021-compliance-stratum-poisson-shift",
    "generation_equations": [
      {
        "label": "Covariates and instrument",
        "expression": "X~N_p(0,Sigma), Sigma_jk=1*0.5^|j-k|; gamma1_j=gamma2_j=j^-2; Z|X~Bernoulli(expit(X'gamma1)); p=200."
      },
      {
        "label": "Potential treatment",
        "expression": "e_d0,e_d1 iid N(0,1); D0=I(X'gamma2-1+e_d0>=0); D1*=I(X'gamma2+1+e_d1>=0); D1=max(D1*,D0); D=Z D1+(1-Z)D0."
      },
      {
        "label": "Potential outcomes",
        "expression": "e0~N(0,1), beta_j=2*j^-2; K11~Poisson(lambda11), K00~Poisson(0.5); B=X'beta+e0+K11*I(D0=1)+K00*I(D1=0); Y0=B; Y1=1+B; Y=D Y1+(1-D)Y0."
      },
      {
        "label": "Source scenarios",
        "expression": "lambda11 in {0.5,0.75,1,1.25}; no interactions; source alpha0=1."
      }
    ],
