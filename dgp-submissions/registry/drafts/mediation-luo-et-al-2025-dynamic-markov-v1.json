  "mechanism": {
    "name": "Finite-horizon Markov mediation with three contemporaneous mediators",
    "title_en": null,
    "family_id": "luo-et-al-2025-markov-dynamic-three-mediator",
    "generation_equations": [
      {
        "label": "Treatment",
        "expression": "A_t iid~Bernoulli(.5), t=1,...,10"
      },
      {
        "label": "Coefficients",
        "expression": "Every entry of Theta_1t=(alpha_1t,delta_1t,Gamma_1t,zeta_1t) and Theta_2t=(alpha_2t,delta_2t,gamma_2t,zeta_2t,kappa_t) is drawn independently Uniform(-0.5,0.5); realized arrays stored in config.json"
      },
      {
        "label": "Mediators",
        "expression": "mu_t=alpha_1t+delta_1t A_t+Gamma_1t M_(t-1)+zeta_1t R_(t-1); M_t=mu_t+(I-W^T)^-1 epsilon_wt. Equivalently M_t-mu_t=W^T(M_t-mu_t)+epsilon_wt"
      },
      {
        "label": "Outcome",
        "expression": "R_t=alpha_2t+delta_2t A_t+gamma_2t^T M_(t-1)+zeta_2t R_(t-1)+kappa_t^T M_t+epsilon_rt"
      },
      {
        "label": "W",
        "expression": "[[0,-0.80,0.61],[0,0,-0.82],[0,0,0]]; M_0=0,R_0=0; epsilon_wt and epsilon_rt independent standard normal"
      },
      {
        "label": "Target",
        "expression": "eta_1^(10)= [E sum R_t|do A=1 - E sum R_t|do A=0] - [E sum R_t|do A=1,M_t1=0 - E sum R_t|do A=0,M_t1=0]"
      }
    ],
