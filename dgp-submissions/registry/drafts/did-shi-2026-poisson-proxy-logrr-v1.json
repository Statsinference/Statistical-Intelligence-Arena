  "mechanism": {
    "name": "Truncated-normal-factor Poisson donor-and-proxy panel",
    "title_en": null,
    "family_id": "shi-2026-poisson-common-factor-donor-proxy",
    "generation_equations": [
      {
        "label": "factor",
        "expression": "lambda_t iid TN(0.5,0.1^2;(0,1)); t=1,...,200"
      },
      {
        "label": "conditional_marginals",
        "expression": "Y_t|lambda_t ~ Pois(exp(lambda_t-2*1(t>100))); W_1t,W_2t|lambda_t ~ Pois(lambda_t/(e-1))"
      },
      {
        "label": "joint_law_adaptation",
        "expression": "Given lambda_1:200, all 600 observed draws are mutually independent; factors independent across periods."
      },
      {
        "label": "estimand",
        "expression": "log(E[Y_t(1)]/E[Y_t(0)])=-2"
      }
    ],
