{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:statistical-inference-arena:result:0.2.0",
  "title": "Statistical Inference Arena scalar result 0.2.0",
  "description": "Core shape. Python checker additionally enforces endpoint order, disjoint components, path safety and other documented consistency. No scientific validation.",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_kind",
    "task_id",
    "task_version",
    "layer",
    "run_id",
    "mechanism_id",
    "replicate_id",
    "method_id",
    "target_id",
    "target_object",
    "query_id",
    "group_id",
    "status",
    "status_reason",
    "estimate",
    "uncertainty",
    "diagnostics",
    "evidence",
    "runtime",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "artifact_kind": {
      "enum": [
        "illustrative_example",
        "benchmark_run"
      ]
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_version": {
      "type": "string",
      "minLength": 1
    },
    "layer": {
      "enum": [
        "A",
        "B"
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "mechanism_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "replicate_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "method_id": {
      "type": "string",
      "minLength": 1
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "target_object": {
      "enum": [
        "parameter_ci",
        "mean_ci",
        "prediction_set"
      ]
    },
    "query_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "group_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "status": {
      "enum": [
        "ok",
        "not_identified",
        "unsupported",
        "abstained",
        "failed"
      ]
    },
    "status_reason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "estimate": {
      "type": [
        "number",
        "null"
      ]
    },
    "uncertainty": {
      "type": "object",
      "required": [
        "type",
        "coverage_scope",
        "level",
        "interval",
        "standard_error",
        "method"
      ],
      "properties": {
        "type": {
          "enum": [
            "none",
            "standard_error",
            "confidence_interval",
            "credible_interval",
            "prediction_set"
          ]
        },
        "coverage_scope": {
          "enum": [
            "marginal",
            "fixed_query",
            "group",
            "pointwise",
            "simultaneous"
          ]
        },
        "level": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "interval": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "lower",
                "upper"
              ],
              "properties": {
                "lower": {
                  "oneOf": [
                    {
                      "type": "number"
                    },
                    {
                      "enum": [
                        "-inf",
                        "+inf"
                      ]
                    }
                  ]
                },
                "upper": {
                  "oneOf": [
                    {
                      "type": "number"
                    },
                    {
                      "enum": [
                        "-inf",
                        "+inf"
                      ]
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "standard_error": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "method": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "intervals": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "enum": [
                      "-inf",
                      "+inf"
                    ]
                  }
                ]
              },
              {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "enum": [
                      "-inf",
                      "+inf"
                    ]
                  }
                ]
              }
            ],
            "items": false
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "none"
              }
            }
          },
          "then": {
            "properties": {
              "level": {
                "type": "null"
              },
              "interval": {
                "type": "null"
              },
              "standard_error": {
                "type": "null"
              },
              "method": {
                "type": "null"
              }
            },
            "not": {
              "required": [
                "intervals"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "standard_error"
              }
            }
          },
          "then": {
            "properties": {
              "level": {
                "type": "null"
              },
              "interval": {
                "type": "null"
              },
              "standard_error": {
                "type": "number",
                "minimum": 0
              },
              "method": {
                "type": "string",
                "minLength": 1
              }
            },
            "not": {
              "required": [
                "intervals"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "confidence_interval",
                  "credible_interval"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "level": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1
              },
              "interval": {
                "type": "object"
              },
              "method": {
                "type": "string",
                "minLength": 1
              }
            },
            "not": {
              "required": [
                "intervals"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "prediction_set"
              }
            }
          },
          "then": {
            "required": [
              "intervals"
            ],
            "properties": {
              "level": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1
              },
              "interval": {
                "type": "null"
              },
              "standard_error": {
                "type": "null"
              },
              "method": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "status",
          "summary",
          "evidence"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "warn",
              "fail",
              "not_checked"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "wall_seconds",
        "offline_training_seconds",
        "load_seconds",
        "warm_end_to_end_seconds",
        "device",
        "peak_memory_mb",
        "includes",
        "notes"
      ],
      "properties": {
        "wall_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "offline_training_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "load_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "warm_end_to_end_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "device": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "peak_memory_mb": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "includes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "method_name",
        "method_version",
        "method_role",
        "execution_mode",
        "adaptation_steps",
        "code_commit",
        "checkpoint_sha256",
        "input_sha256",
        "seed"
      ],
      "properties": {
        "method_name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "method_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "method_role": {
          "enum": [
            "classical_reference",
            "pfn_adapter",
            "other"
          ]
        },
        "execution_mode": {
          "enum": [
            "native_frozen",
            "adapted",
            "refit"
          ]
        },
        "adaptation_steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "code_commit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "checkpoint_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "input_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "execution_mode": {
                "const": "native_frozen"
              }
            }
          },
          "then": {
            "properties": {
              "adaptation_steps": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "execution_mode": {
                "const": "adapted"
              }
            }
          },
          "then": {
            "properties": {
              "adaptation_steps": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "estimand": {
      "type": "object",
      "required": [
        "id",
        "definition",
        "population",
        "scale",
        "units"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "population": {
          "type": "string",
          "minLength": 1
        },
        "scale": {
          "type": "string",
          "minLength": 1
        },
        "units": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "identifiability": {
      "type": "object",
      "required": [
        "status",
        "justification",
        "identification_formula"
      ],
      "properties": {
        "status": {
          "enum": [
            "identified",
            "partially_identified",
            "not_identified",
            "not_assessed"
          ]
        },
        "justification": {
          "type": "string",
          "minLength": 1
        },
        "identification_formula": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "assessment",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "assessment": {
            "enum": [
              "supplied",
              "supported",
              "uncertain",
              "violated",
              "not_assessed"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "layer": {
            "const": "A"
          }
        }
      },
      "then": {
        "required": [
          "estimand",
          "identifiability",
          "assumptions"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "estimand"
              ]
            },
            {
              "required": [
                "identifiability"
              ]
            },
            {
              "required": [
                "assumptions"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "not": {
              "const": "ok"
            }
          }
        }
      },
      "then": {
        "properties": {
          "status_reason": {
            "type": "string",
            "minLength": 1
          },
          "estimate": {
            "type": "null"
          },
          "uncertainty": {
            "properties": {
              "type": {
                "const": "none"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          },
          "uncertainty": {
            "properties": {
              "type": {
                "not": {
                  "const": "prediction_set"
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "estimate": {
            "type": "number"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "uncertainty": {
            "properties": {
              "type": {
                "const": "prediction_set"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "target_object": {
            "const": "prediction_set"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target_object": {
            "const": "prediction_set"
          }
        }
      },
      "then": {
        "properties": {
          "uncertainty": {
            "properties": {
              "type": {
                "enum": [
                  "none",
                  "prediction_set"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "uncertainty": {
            "properties": {
              "coverage_scope": {
                "not": {
                  "const": "simultaneous"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "uncertainty": {
            "properties": {
              "coverage_scope": {
                "enum": [
                  "fixed_query",
                  "pointwise"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "query_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "uncertainty": {
            "properties": {
              "coverage_scope": {
                "const": "group"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "group_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_kind": {
            "const": "benchmark_run"
          }
        }
      },
      "then": {
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "mechanism_id": {
            "type": "string",
            "minLength": 1
          },
          "replicate_id": {
            "type": "string",
            "minLength": 1
          },
          "runtime": {
            "properties": {
              "wall_seconds": {
                "type": "number",
                "minimum": 0
              },
              "device": {
                "type": "string",
                "minLength": 1
              },
              "includes": {
                "minItems": 1
              }
            }
          },
          "provenance": {
            "properties": {
              "method_name": {
                "type": "string",
                "minLength": 1
              },
              "method_version": {
                "type": "string",
                "minLength": 1
              },
              "input_sha256": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "layer": {
            "const": "A"
          },
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "identifiability": {
            "properties": {
              "status": {
                "const": "identified"
              }
            }
          }
        }
      }
    }
  ]
}
